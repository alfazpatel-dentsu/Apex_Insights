
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }
    
    // CLIENTS
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // LEADS
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // KPI DATA & WEEKLY BREAKDOWN
    match /kpis/{kpiId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /kpiWeeklyData/{weeklyDataId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // KPI DEFINITIONS
    match /kpiDefinitions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // CHANNELS
    match /channels/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // SPENDS
    match /monthlySpends/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /weeklySpends/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // BUSINESS SNAPSHOTS
    match /businessSnapshots/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // SETTINGS (email automations, Teams webhook, etc.)
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // MAIL AUDIT LOG (written by Cloud Functions Admin SDK)
    match /mailLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // IN-APP TEAM NOTIFICATIONS
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // MAIL JOBS (test / reset / invite — processed by onMailJobCreated)
    match /mailJobs/{id} {
      allow create: if
        (
          request.resource.data.type == 'reset'
          && request.resource.data.email is string
          && request.resource.data.status == 'queued'
        )
        || (
          isAdmin()
          && request.resource.data.type in ['test', 'invite', 'reset', 'mom']
        );
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // DEPRECATED COLLECTIONS (Maintenance)
    match /actionItems/{id} { allow read, write: if isSignedIn(); }
    match /wbrEntries/{id} { allow read, write: if isSignedIn(); }
    match /pageManagement/{id} { allow read, write: if isSignedIn(); }
    match /clusterInsights/{id} { allow read, write: if isSignedIn(); }
  }
}
