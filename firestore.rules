rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userProfile().data.status in ['User Registered', 'Active', 'Invite sent'];
    }

    // Temporary compatibility for the existing Sokrati-only user documents.
    // Delete this after all users have memberships.sokrati backfilled.
    function isLegacySokratiUser() {
      return isApproved() && !('memberships' in userProfile().data);
    }

    function hasAgencyAccess(agencyId) {
      return isApproved() &&
        'memberships' in userProfile().data &&
        agencyId in userProfile().data.memberships &&
        userProfile().data.memberships[agencyId].status == 'active';
    }

    function canAccessAgency(agencyId) {
      return hasAgencyAccess(agencyId) ||
        (agencyId == 'sokrati' && isLegacySokratiUser());
    }

    // Only platform administrators can edit agency membership records. Agency
    // administrators must use a trusted server-side membership workflow.
    function isPlatformAdmin() {
      return isApproved() && (
        request.auth.token.email in [
          'alfaz.patel@dentsu.com',
          'hasnain.rasiwalla1@dentsu.com',
          'mehul.kulkarni@dentsu.com'
        ] ||
        (userProfile().data.role == 'Admin' && !('memberships' in userProfile().data)) ||
        ('groupPermissions' in userProfile().data &&
          'platform_admin' in userProfile().data.groupPermissions)
      );
    }

    function isValidInitialMembership(memberships, agencyId) {
      return !(agencyId in memberships) || (
        memberships[agencyId].keys().hasOnly(['status', 'role', 'permissions']) &&
        memberships[agencyId].status == 'pending' &&
        memberships[agencyId].role == 'Client Partner' &&
        memberships[agencyId].permissions == []
      );
    }

    function isValidSelfRegistration() {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'status', 'permissions',
          'memberships', 'groupPermissions', 'requestedAgency'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email.matches('^[^@]+@(dentsu|iprospect)\\.com$') &&
        request.resource.data.role == 'Client Partner' &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.permissions == [] &&
        request.resource.data.groupPermissions == [] &&
        request.resource.data.requestedAgency in ['sokrati', 'iprospect'] &&
        request.resource.data.memberships.keys().hasOnly(['sokrati', 'iprospect']) &&
        request.resource.data.requestedAgency in request.resource.data.memberships &&
        isValidInitialMembership(request.resource.data.memberships, 'sokrati') &&
        isValidInitialMembership(request.resource.data.memberships, 'iprospect');
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidSelfRegistration()
        || isPlatformAdmin();
      allow update, delete: if isPlatformAdmin();
      allow update: if isApproved() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'lastOtpVerifiedAt', 'hasSeenGuidedTour'
        ]);
      allow update: if isSignedIn() && request.auth.uid == userId &&
        resource.data.status == 'Pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOtpVerifiedAt']);
    }

    // All new business data must live below an agency. This is the security
    // boundary that prevents one agency from reading or writing another's data.
    match /agencies/{agencyId}/{document=**} {
      allow read, write: if agencyId in ['sokrati', 'iprospect'] && canAccessAgency(agencyId);
    }
    match /agencies/{agencyId}/actionItems/{id} {
      allow read: if agencyId in ['sokrati', 'iprospect'] && canAccessAgency(agencyId);
      allow create: if agencyId in ['sokrati', 'iprospect'] &&
        canAccessAgency(agencyId) &&
        (!('createdBy' in request.resource.data) ||
          request.resource.data.createdBy == request.auth.uid) &&
        (!('updatedBy' in request.resource.data) ||
          request.resource.data.updatedBy == request.auth.uid);
      allow update: if agencyId in ['sokrati', 'iprospect'] &&
        canAccessAgency(agencyId) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedBy']) ||
          request.resource.data.updatedBy == request.auth.uid
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']) ||
          (!('createdBy' in resource.data) &&
            request.resource.data.createdBy == request.auth.uid) ||
          ('createdBy' in resource.data &&
            request.resource.data.createdBy == resource.data.createdBy)
        );
      allow delete: if agencyId in ['sokrati', 'iprospect'] && canAccessAgency(agencyId);
    }

    // Legacy root collections are Sokrati-only during migration. No iProspect
    // member can access them. Remove these matches after the migration cutover.
    match /clients/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /leads/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /kpis/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /kpiWeeklyData/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /kpiDefinitions/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /channels/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /monthlySpends/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /weeklySpends/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /businessSnapshots/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /actionItems/{id} {
      allow read: if canAccessAgency('sokrati');
      allow create: if canAccessAgency('sokrati') &&
        (!('createdBy' in request.resource.data) ||
          request.resource.data.createdBy == request.auth.uid) &&
        (!('updatedBy' in request.resource.data) ||
          request.resource.data.updatedBy == request.auth.uid);
      allow update: if canAccessAgency('sokrati') &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedBy']) ||
          request.resource.data.updatedBy == request.auth.uid
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']) ||
          (!('createdBy' in resource.data) &&
            request.resource.data.createdBy == request.auth.uid) ||
          ('createdBy' in resource.data &&
            request.resource.data.createdBy == resource.data.createdBy)
        );
      allow delete: if canAccessAgency('sokrati');
    }
    match /wbrEntries/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /pageManagement/{id} { allow read, write: if canAccessAgency('sokrati'); }
    match /clusterInsights/{id} { allow read, write: if canAccessAgency('sokrati'); }

    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isPlatformAdmin();
    }
    match /productAnnouncements/{id} {
      allow read: if isApproved();
      allow create: if isPlatformAdmin() &&
        request.resource.data.keys().hasOnly([
          'title', 'body', 'href', 'key', 'createdBy', 'createdAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 4000 &&
        request.resource.data.href is string &&
        request.resource.data.href.matches('^/[^/].*|^/$') &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /mailLog/{id} { allow read: if isPlatformAdmin(); allow write: if false; }
    match /mailJobs/{id} {
      allow create: if isSignedIn() && (request.resource.data.type in ['reset', 'otp'] &&
          request.resource.data.email is string && request.resource.data.status == 'queued')
        || (isPlatformAdmin() && request.resource.data.type in ['test', 'invite', 'reset', 'mom', 'otp'] &&
          request.resource.data.status == 'queued');
      allow read: if isPlatformAdmin();
      allow update, delete: if false;
    }
    match /pendingOtps/{id} {
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && resource.data.email == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'verified']);
      allow delete: if false;
    }
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /accessAuditLog/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /actionItemActivity/{id} {
      allow read: if isApproved() &&
        resource.data.agencyId is string &&
        canAccessAgency(resource.data.agencyId);
      allow write: if false;
    }
  }
}
